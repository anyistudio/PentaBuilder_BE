def _load_snapshot(configured_app):
    Open a backend session, read the active data version, load the matching catalog snapshot, then close the session.


class FixedSelectorLLM:
    Pretend to be the cheap selector model used inside `resolve_catalog_slug`.
    Always return one preconfigured slug so the test can verify selector fallback behavior deterministically.


def test_resolve_catalog_slug_can_fallback_to_selector_model(configured_app, monkeypatch):
    Build a `CatalogToolset` with the fixed selector model.
    Force deterministic auto-selection to fail so the resolver must use the selector-model branch.
    Verify the returned result is resolved, carries the chosen slug, and records selector-model usage metadata.


def test_resolve_catalog_slug_uses_fuzzy_match_for_near_miss_item_id(configured_app):
    Ask the resolver to map a near-miss Wild Rift item ID such as `wr-ludens-echo`.
    Verify the blended fuzzy ranking lands on the real catalog ID `wr-luden-s-echo` without needing selector fallback.


def test_search_catalog_returns_top_match_with_real_id_and_params(configured_app):
    Run item search with a close textual query such as `ludens echo`.
    Verify the tool returns a top-ranked match, exposes the real `id`, and includes lightweight item parameters.


def test_list_item_ids_returns_real_ids_for_magic_items(configured_app):
    Ask the new `list_item_ids` helper for the `magic` category in Wild Rift.
    Verify the response returns real item IDs and that common AP items appear in the listing.


def test_validate_run_result_reports_field_level_slug_errors(configured_app):
    Validate a `recommend_full_build` payload that includes an invalid item slug.
    Verify the raised `ApiError` reports the exact failing field path and unknown-slug message.


def test_validate_run_result_accepts_seven_step_build_order_with_boots_and_enchant(configured_app):
    Validate a correct Wild Rift seven-step build order with a separate enchant step.
    Verify the normalized result preserves the build order and translates slot notes into explanation targets.


def test_validate_run_result_rejects_wild_rift_build_order_without_seven_steps(configured_app):
    Validate a Wild Rift build order that is one step too short.
    Verify contract validation rejects it with the documented seven-slot error.


def test_validate_run_result_rejects_lol_recommend_full_build_with_enchant_step(configured_app):
    Validate a LoL build order that incorrectly includes a separate enchant step.
    Verify the contract layer rejects the enchant slot for PC League.
