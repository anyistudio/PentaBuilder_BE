APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET=replace-with-random-string
LOG_LEVEL=INFO
ACCESS_TOKEN_TTL_SECONDS=3600
DEV_AUTH_ENABLED=false

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME

S3_ENDPOINT=https://your-object-storage-endpoint
S3_BUCKET=pentabuilder-prod
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_REGION=us-east-1

GAME_DATA_SOURCE=s3
GAME_DATA_LOCAL_ROOT=game_data
GAME_DATA_S3_ROOT=game_data/
GAME_LOCALIZATION_ROOT=game_localization/
BENCHMARK_LOCAL_ROOT=benchmark_datasets/

JWT_SIGNING_KEY=replace-with-32-byte-min-secret
CLERK_SECRET_KEY=replace-me
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

GOOGLE_API_KEY=replace-me
OPENAI_API_KEY=replace-me
ALL_MODELS=
PRIMARY_REASONING_PROVIDER=google
PRIMARY_REASONING_MODEL=gemini-3-flash-preview
FAST_REASONING_PROVIDER=google
FAST_REASONING_MODEL=gemini-3-flash-preview
CALIBRATION_PROVIDER=google
CALIBRATION_MODEL=gemini-3-flash-preview
